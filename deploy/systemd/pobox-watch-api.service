[Unit]
Description=pobox.watch Node API
After=network.target postgresql.service

[Service]
Type=simple
User=poboxwatchapp
Group=poboxwatchapp
WorkingDirectory=/opt/pobox.watch/current/server
EnvironmentFile=/etc/pobox.watch/pobox-watch.env
ExecStart=/usr/bin/node dist/src/index.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
